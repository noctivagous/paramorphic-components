{
  "name": "paramorphic-runtime-v4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:replay": "esbuild scripts/verify-morph-replay.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-morph-replay.cjs --log-level=error && node /tmp/verify-morph-replay.cjs",
    "dev:spreadsheet": "vite --config apps/spreadsheet/vite.config.ts",
    "build:spreadsheet": "vite build --config apps/spreadsheet/vite.config.ts",
    "preview:spreadsheet": "vite preview --config apps/spreadsheet/vite.config.ts",
    "dev:player": "vite --config apps/player/vite.config.ts",
    "build:player": "vite build --config apps/player/vite.config.ts",
    "preview:player": "vite preview --config apps/player/vite.config.ts",
    "dev:keyboard": "vite --config apps/keyboard/vite.config.ts",
    "build:keyboard": "vite build --config apps/keyboard/vite.config.ts",
    "preview:keyboard": "vite preview --config apps/keyboard/vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
