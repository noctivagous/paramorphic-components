{
  "name": "paramorphic-runtime-v4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:replay": "esbuild scripts/verify-morph-replay.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-morph-replay.cjs --log-level=error && node /tmp/verify-morph-replay.cjs",
    "dev:spreadsheet": "vite --config apps/spreadsheet/vite.config.ts",
    "build:spreadsheet": "vite build --config apps/spreadsheet/vite.config.ts",
    "preview:spreadsheet": "vite preview --config apps/spreadsheet/vite.config.ts",
    "dev:player": "vite --config apps/player/vite.config.ts",
    "build:player": "vite build --config apps/player/vite.config.ts",
    "preview:player": "vite preview --config apps/player/vite.config.ts",
    "dev:keyboard": "vite --config apps/keyboard/vite.config.ts",
    "build:keyboard": "vite build --config apps/keyboard/vite.config.ts",
    "preview:keyboard": "vite preview --config apps/keyboard/vite.config.ts",
    "dev:browser": "vite --config apps/browser/vite.config.ts",
    "build:browser": "vite build --config apps/browser/vite.config.ts",
    "verify:browser": "esbuild scripts/verify-browser.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-browser.cjs --log-level=error && node /tmp/verify-browser.cjs",
    "test": "node --test",
    "lint:boundaries": "node scripts/import-boundaries.mjs",
    "metrics": "node scripts/report-app-metrics.mjs",
    "verify:tilings": "esbuild scripts/verify-tilings.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-tilings.cjs --log-level=error && node /tmp/verify-tilings.cjs",
    "lint:rules": "node scripts/lint-rule-identity.mjs",
    "verify:turns": "esbuild scripts/verify-turns.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-turns.cjs --log-level=error && node /tmp/verify-turns.cjs",
    "verify:rules": "esbuild scripts/verify-rules.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-rules.cjs --log-level=error && node /tmp/verify-rules.cjs",
    "verify:games": "esbuild scripts/verify-games.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-games.cjs --log-level=error && node /tmp/verify-games.cjs",
    "gen:plans": "esbuild scripts/generate-game-plans.ts --bundle --platform=node --format=cjs --outfile=/tmp/generate-game-plans.cjs --log-level=error && node /tmp/generate-game-plans.cjs",
    "verify:selection": "esbuild scripts/verify-selection.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-selection.cjs --log-level=error && node /tmp/verify-selection.cjs",
    "verify:sheet": "esbuild scripts/verify-sheet-ops.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-sheet-ops.cjs --log-level=error && node /tmp/verify-sheet-ops.cjs",
    "dev:gui-builder": "vite --config apps/gui-builder/vite.config.ts --port 5177",
    "build:gui-builder": "vite build --config apps/gui-builder/vite.config.ts",
    "preview:gui-builder": "vite preview --config apps/gui-builder/vite.config.ts --port 4177",
    "verify:gui": "esbuild scripts/verify-gui.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-gui.cjs --log-level=error && node /tmp/verify-gui.cjs",
    "verify:relations": "esbuild scripts/verify-relations.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-relations.cjs --log-level=error && node /tmp/verify-relations.cjs",
    "export": "esbuild scripts/export-app.ts --bundle --platform=node --format=cjs --outfile=/tmp/export-app.cjs --log-level=error && node /tmp/export-app.cjs",
    "verify:export": "esbuild scripts/verify-export.ts --bundle --platform=node --format=cjs --outfile=/tmp/verify-export.cjs --log-level=error && node /tmp/verify-export.cjs",
    "dev:supershape": "vite --config apps/supershape/vite.config.ts --port 5178",
    "build:supershape": "vite build --config apps/supershape/vite.config.ts",
    "preview:supershape": "vite preview --config apps/supershape/vite.config.ts --port 4178"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
